# ─────────────────────────────────────────────────────────────────────────
# Configuración de ejemplo — copie a `.env` y complete los valores.
# NUNCA versione el archivo `.env` real: contiene credenciales SMTP.
# En producción use Azure Key Vault / AWS Secrets Manager.
# ─────────────────────────────────────────────────────────────────────────

# Servidor de correo institucional (Office 365 / Gmail corporativo)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=certificados@lasalle.edu.co
SMTP_PASS=cambie-esta-clave-por-la-real
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_NAME=Certificados Unilasallista
SMTP_TIMEOUT=30
SMTP_MAX_REINTENTOS=3

# Modo simulación: no envía correos reales, solo registra la intención.
# Útil para demostraciones y pruebas. Poner en False para envío real.
SMTP_MODO_SIMULACION=True

# Base de datos de trazabilidad
DB_PATH=certificados.db

# Protective de los PDF (contraseña = número de documento del participante)
PDF_PROTEGER=False

# Plantilla institucional usada por defecto (archivo dentro de templates/)
PLANTILLA_BASE=certificado_base.pdf

# Fecha impresa en los certificados
FECHA_CERTIFICADO=13 de noviembre del 2026

# Umbral de similitud para detección de duplicados (0-100)
UMBRAL_DUPLICADOS=90
UMBRAL_ENCABEZADOS=85

# Secreto de la aplicación Flask (generar con: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=cambie-esta-clave-por-una-aleatoria

# IA generativa (opcional). Si se deja vacío se usan plantillas institucionales.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
